				rockchip,pins = <0x2 0xe 0x1 0x9e 0x2 0xf 0x1 0x9e>;
				phandle = <0x12d>;
			};
		};

		lcd {

			lcd-en-pins {
				rockchip,pins = <0x7 0x3 0x0 0x9e>;
				phandle = <0x8f>;
			};

			lcd-rst-pins {
				rockchip,pins = <0x7 0x4 0x0 0x9e>;
				phandle = <0x90>;
			};
		};

		sdio-pwrseq {

			wifi-enable-h {
				rockchip,pins = <0x4 0x1c 0x0 0x9e>;
				phandle = <0xa4>;
			};
		};

		headset {

			hp-det {
				rockchip,pins = <0x7 0x7 0x0 0x9f>;
				phandle = <0xab>;
			};
		};

		bt {

			uart0-rts-gpio {
				rockchip,pins = <0x4 0x13 0x0 0x9e>;
				phandle = <0xa7>;
			};
		};

		camera {

			camera-pwr {
				rockchip,pins = <0x0 0x11 0x0 0x9e>;
				phandle = <0xac>;
			};
		};
	};

	rockchip-suspend {
		compatible = "rockchip,pm-rk3288";
		status = "disabled";
		rockchip,sleep-mode-config = <0x80207>;
		rockchip,wakeup-config = <0x8>;
		rockchip,pwm-regulator-config = <0x4>;
		phandle = <0x12e>;
	};

	backlight {
		compatible = "pwm-backlight";
		status = "okay";
		pwms = <0xa2 0x0 0x61a8 0x0>;
		enable-gpios = <0x38 0x2 0x0>;

		default-brightness-level = <0x50>;
		phandle = <0x8c>;
	};

	chosen {
		bootargs = "console=ttyFIQ0 console=tty0 fbcon=font:SUN12x22 androidboot.hardware=rk30board androidboot.boot_devices=ff0f0000.dwmmc androidboot.super_partition=system androidboot.selinux=permissive rkwdt=0 blkdevparts=mmcblk0:4M@8M(uboot),4M@12M(misc),16M@16M(resource),16M@32M(kernel),32M@48M(boot),32M@80M(recovery),52M@112M(backup),128M@164M(cache),4M@292M(kpanic),3072M@296M(system),16M@3368M(metadata),64M@3384M(radical_update),-@3448M(userdata) loglevel=4 printk.time=1 printk.devkmsg=on androidboot.storagemedia=emmc clk_ignore_unused log_buf_len=1M androidboot.serialno=RK3288IFIVE01";
	};

	fb {
		status = "okay";
		compatible = "rockchip,rk-fb";
		rockchip,disp-mode = <0x0>;
	};


	vcc18-saradc-vref {
		compatible = "regulator-fixed";
		regulator-name = "saradc_vref_1v8";
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
		regulator-always-on;
		phandle = <0x1f>;
	};

	vcc-5v-en {
		compatible = "regulator-fixed";
		regulator-name = "vcc_5v";
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		gpio = <0x38 0xc 0x0>;
		enable-active-high;
		regulator-always-on;
		regulator-boot-on;
		phandle = <0x12f>;
	};

	adc-keys {
		compatible = "adc-keys";
		io-channels = <0xa3 0x1>;
		io-channel-names = "buttons";
		keyup-threshold-microvolt = <0x1b7740>;

		vol-up {
			label = "volume up";
			linux,code = <0x73>;
			press-threshold-microvolt = <0x48f4c>;
		};

		vol-down {
			label = "volume down";
			linux,code = <0x72>;
			press-threshold-microvolt = <0x6de>;
		};
	};

	xin32k {
		compatible = "fixed-clock";
		clock-frequency = <0x8000>;
		clock-output-names = "xin32k";
		#clock-cells = <0x0>;
		phandle = <0x130>;
	};

	sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		pinctrl-names = "default";
		pinctrl-0 = <0xa4>;
		reset-gpios = <0xa5 0x1c 0x1>;
		post-power-on-delay-ms = <0xc8>;
		phandle = <0x18>;
	};

	wireless-wlan {
		compatible = "wlan-platdata";
		rockchip,grf = <0x44>;
		wifi_chip_type = "ap6255";
		WIFI,host_wake_irq = <0xa5 0x1e 0x0>;
		status = "okay";
	};

	wireless-bluetooth {
		compatible = "bluetooth-platdata";
		uart_rts_gpios = <0xa5 0x13 0x1>;
		pinctrl-names = "default", "rts_gpio";
		pinctrl-0 = <0xa6>;
		pinctrl-1 = <0xa7>;
		BT,reset_gpio = <0xa5 0x1d 0x0>;
		BT,wake_gpio = <0xa5 0x1a 0x0>;
		BT,wake_host_irq = <0xa5 0x1f 0x0>;
		status = "okay";
	};

	speaker-amplifier {
		compatible = "simple-audio-amplifier";
		enable-gpios = <0x38 0xf 0x0>;
		sound-name-prefix = "Speaker Amp";
		phandle = <0xa8>;
	};

	sound {
		compatible = "simple-audio-card";
		#address-cells = <0x1>;
		#size-cells = <0x0>;
		simple-audio-card,name = "realtek,rt5616-codec";
		simple-audio-card,mclk-fs = <0x100>;
		simple-audio-card,aux-devs = <0xa8>;
		simple-audio-card,widgets = "Microphone", "Microphone Jack", "Headphone", "Headphones", "Speaker", "Speaker";
		simple-audio-card,routing = "MIC1", "Microphone Jack", "MIC2", "Microphone Jack", "Microphone Jack", "micbias1", "Headphones", "HPOL", "Headphones", "HPOR", "Speaker Amp INL", "LOUTL", "Speaker Amp INR", "LOUTR", "Speaker", "Speaker Amp OUTL", "Speaker", "Speaker Amp OUTR";

		simple-audio-card,dai-link@0 {
			reg = <0x0>;
			format = "i2s";

			cpu {
				sound-dai = <0xa9>;
			};

			codec {
				sound-dai = <0xaa>;
			};
		};

		simple-audio-card,dai-link@1 {
			reg = <0x1>;
			format = "i2s";

			cpu {
				sound-dai = <0xa9>;
			};

			codec {
				sound-dai = <0xaa>;
			};
		};

		simple-audio-card,dai-link@2 {
			reg = <0x2>;
			format = "i2s";

			cpu {
				sound-dai = <0xa9>;
			};

			codec {
				sound-dai = <0xaa>;
			};
		};
	};

	rockchip-headset {
		compatible = "rockchip_headset";
		headset_gpio = <0x38 0x7 0x1>;
		pinctrl-names = "default";
		pinctrl-0 = <0xab>;
		io-channels = <0xa3 0x2>;
	};

	vcc-camera-regulator {
		compatible = "regulator-fixed";
		gpio = <0x2e 0x11 0x0>;
		pinctrl-names = "default";
		pinctrl-0 = <0xac>;
		regulator-name = "vcc_camera";
		enable-active-high;
		regulator-always-on;
		regulator-boot-on;
		phandle = <0x34>;
	};


# Three FramebufferSurface buffers: with two, GPU (client) composition renders into the
# buffer the display released only at the last vblank, so SurfaceFlinger misses frames
# whenever it composes on the GPU (rounded-corner task tiles in recents).
ro.surface_flinger.max_frame_buffer_acquired_buffers=3

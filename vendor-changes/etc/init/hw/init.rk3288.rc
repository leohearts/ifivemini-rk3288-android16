on property:sys.boot_completed=1
    chown system system /sys/class/devfreq/ffa30000.gpu/governor
    chown system system /sys/class/devfreq/ffa30000.gpu/min_freq
    chown system system /sys/class/devfreq/ffa30000.gpu/max_freq
    # Boot finished: drop the kernel's boot deadline (rkdeadline= in bootargs),
    # which reboots the board if Android never gets this far.
    write /sys/module/rk_wdt_backstop/parameters/rkdeadline_cancel 1

on early-boot
    # Update dm-verity state and set partition.*.verified properties
    verity_update_state

on init
    # Increased power consumption and CPU in exchange for memory
    write /proc/sys/vm/swappiness 100
    write /sys/block/zram0/comp_algorithm lz4

on property:sys.boot_completed=1
    # recover cpu&ddr fre.
    chmod  0644 /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor interactive

# DDR: the kernel keeps the bootloader's 396 MHz (rk3288 cros DMC, userspace
# devfreq governor). 456 MHz is the stock firmware's NORMAL rate; the memory bus
# saturates at 396 MHz during UI animations. Set after boot; while no display
# is scanning out the kernel drops to 396 MHz and comes back to this rate.
# persist.vendor.ifive.ddr_freq=396|456 (iFive settings app; the two OPPs in the
# device tree) overrides the 456 MHz default.
on property:sys.boot_completed=1
    write /sys/class/devfreq/ff610000.dmc-cros/userspace/set_freq 456000000
on property:sys.boot_completed=1 && property:persist.vendor.ifive.ddr_freq=396
    write /sys/class/devfreq/ff610000.dmc-cros/userspace/set_freq 396000000
on property:sys.boot_completed=1 && property:persist.vendor.ifive.ddr_freq=456
    write /sys/class/devfreq/ff610000.dmc-cros/userspace/set_freq 456000000

# Deep Doze without a motion sensor: the static vendor overlay
# com.leohearts.overlay.deepdoze applies only when ro.vendor.ifive.deep_doze=1.
# Set here, after persist properties load and before zygote scans overlays;
# persist.vendor.ifive.deep_doze=0 (iFive settings app) turns it off.
on post-fs-data
    setprop ro.vendor.ifive.deep_doze ${persist.vendor.ifive.deep_doze:-1}

# Kernel suspend level (arch/arm/mach-rockchip/pm.c): deep (logic off, DDR in
# self-refresh, 32 kHz clock) by default; persist.vendor.ifive.deep_sleep=0
# falls back to CPU-only off.
on property:persist.vendor.ifive.deep_sleep=0
    write /sys/module/pm/parameters/deep_sleep N
on property:persist.vendor.ifive.deep_sleep=1
    write /sys/module/pm/parameters/deep_sleep Y

on boot

    # update foreground cpuset now that processors are up
    # reserve CPU 3 for the top app
    write /dev/cpuset/foreground/cpus 0-3
    write /dev/cpuset/foreground/boost/cpus 0-3
    write /dev/cpuset/background/cpus 0-2
    write /dev/cpuset/system-background/cpus 0-2
    write /dev/cpuset/top-app/cpus 0-3

    chown system system /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor
    chmod 0660 /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor
    chown system system /sys/devices/system/cpu/cpu0/cpufreq/scaling_available_frequencies
    chmod 0440 /sys/devices/system/cpu/cpu0/cpufreq/scaling_available_frequencies
    chown system system /sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq
    chmod 0660 /sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq
    chown system system /sys/devices/system/cpu/cpu0/cpufreq/scaling_min_freq
    chmod 0660 /sys/devices/system/cpu/cpu0/cpufreq/scaling_min_freq
    chown system system  /sys/devices/system/cpu/cpufreq/interactive/boostpulse
    chmod 0660 /sys/devices/system/cpu/cpufreq/interactive/boostpulse
  

# Rockchip SPDIF toggle (persist.spdif_sounds=1) mutes the speaker: no SPDIF card on this board
on property:sys.boot_completed=1
    setprop persist.spdif_sounds 0

# Charger input above 500 mA (rn5t618 driver, chg_boost): off until boot completes,
# then persist.vendor.chg.boost: auto (default; charge under 95% and SoC under 70 C),
# on, or off. The driver also steps the limit down by battery temperature.
on property:sys.boot_completed=1
    write /sys/module/rn5t618_power/parameters/chg_boost 1
on property:sys.boot_completed=1 && property:persist.vendor.chg.boost=auto
    write /sys/module/rn5t618_power/parameters/chg_boost 1
on property:sys.boot_completed=1 && property:persist.vendor.chg.boost=on
    write /sys/module/rn5t618_power/parameters/chg_boost 2
on property:sys.boot_completed=1 && property:persist.vendor.chg.boost=off
    write /sys/module/rn5t618_power/parameters/chg_boost 0
